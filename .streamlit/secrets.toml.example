# SepsiArc — AIMLAPI Configuration Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to: .streamlit/secrets.toml
# Fill in your actual values below.
# ⚠️  NEVER commit secrets.toml to Git — it is already listed in .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# Your AIMLAPI API key (generate at https://aimlapi.com/app/keys)
AIMLAPI_API_KEY = "YOUR_AIMLAPI_KEY_HERE"


# Model ID to use for chat completions.
# Recommended options (verify availability in your plan):
#   "gpt-4o-mini"                    — fast, cost-effective, high quality
#   "gpt-4o"                         — higher quality, more expensive
#   "google/gemma-3-4b-it"           — open-source option
#   "mistralai/Mistral-7B-Instruct-v0.2"
#
# Full list: https://docs.aimlapi.com/api-references/text-models-llm
AIMLAPI_MODEL = "gpt-4o-mini"
